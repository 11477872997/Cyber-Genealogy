    "role": { "bsonType": "string", "enum": ["viewer", "editor"] },
    "created_by": { "bsonType": "string" },
    "created_at": { "bsonType": "timestamp" },
    "expires_at": { "bsonType": "timestamp" },
    "revoked": { "bsonType": "bool" }
  }
}
