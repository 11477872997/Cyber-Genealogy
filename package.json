{
  "name": "cyber-genealogy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env UNI_INPUT_DIR=. uni -p h5 --host 0.0.0.0 --port 4173",
    "dev:h5": "cross-env UNI_INPUT_DIR=. uni -p h5 --host 0.0.0.0 --port 4173",
    "dev:mp-weixin": "cross-env UNI_INPUT_DIR=. uni -p mp-weixin",
    "test": "node --test tests/genealogyStore.test.mjs",
    "build": "npm run build:h5",
    "build:h5": "cross-env UNI_INPUT_DIR=. uni build -p h5 && node scripts/copy-static.mjs h5",
    "build:mp-weixin": "cross-env UNI_INPUT_DIR=. uni build -p mp-weixin && node scripts/copy-static.mjs mp-weixin",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@dcloudio/uni-app": "^3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-h5": "^3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-mp-weixin": "^3.0.0-alpha-5020620260914001",
    "@vue/shared": "3.4.21",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.0.15",
    "@dcloudio/vite-plugin-uni": "^3.0.0-alpha-5020620260914001",
    "@vitejs/plugin-vue": "^5.2.1",
    "cross-env": "^7.0.3",
    "vite": "^5.2.8"
  }
}
